{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alexvinola/stemma-cli/master/schema/canonical-v2.schema.json",
  "title": "Stemma canonical project metadata (v2)",
  "description": "The root of this schema describes .stemma/project.json, which holds project-level metadata only. From version 2 the entities themselves live in Markdown files under .stemma/ (context/, rules/, procedures/, skills/, agents/, decisions/), one file per entity, named after the entity id's slug. Their YAML front matter shapes are documented in $defs so editors can validate them and so the enums stay in one place. Machine bookkeeping — provenance and preserved opaque content — lives in .stemma/provenance.json, described by $defs/provenanceFile. Stemma validates with internal/canonical and internal/store, which additionally check id shapes, glob syntax, activation union invariants and opaque block hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "targets"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1, "description": "Stable project identifier." },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "language": { "type": "string" },
    "framework": { "type": "string" },
    "architectureStyle": { "type": "string" },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/targetFormat" } },
    "tokenBudgets": { "$ref": "#/$defs/tokenBudgets" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "targetFormat": { "enum": ["github-copilot", "claude", "codex", "kiro", "cursor"] },
    "entityId": {
      "type": "string",
      "pattern": "^(context|rule|procedure|skill|agent|decision|opaque)\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "\"<entityType>.<slug>\". The slug is also the file name: rule.api-validation lives in .stemma/rules/api-validation.md. Profile overrides are keyed by this id."
    },
    "tokenBudgets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Advisory limits. Zero or absent means no budget.",
      "properties": {
        "alwaysOn": { "type": "integer", "minimum": 0 },
        "worstCaseRequest": { "type": "integer", "minimum": 0 }
      }
    },
    "activation": {
      "type": "object",
      "description": "Front matter key present on context and rule files. Exhaustive tagged union; fields that do not belong to the tag must be absent.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["always", "path-scoped", "on-demand", "documentation-only"] },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "trigger": { "type": "string" },
        "invocationName": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "path-scoped" } }, "required": ["type"] },
          "then": { "required": ["include"], "properties": { "include": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "type": { "const": "always" } }, "required": ["type"] },
          "then": { "not": { "anyOf": [{ "required": ["include"] }, { "required": ["exclude"] }, { "required": ["trigger"] }] } }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "description": "Provider-specific data Stemma preserves but does not interpret, keyed by provider identifier. Keys beginning with \"stemma.\" are reserved round-trip hints and are never written into generated provider files.",
      "additionalProperties": { "type": "object" }
    },
    "contextFile": {
      "type": "object",
      "description": "Front matter of .stemma/context/<slug>.md. The Markdown body is the document's content.",
      "additionalProperties": false,
      "required": ["title", "activation"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["product", "technology", "architecture", "structure", "domain", "conventions", "security", "testing", "operations", "other"] },
        "audience": { "enum": ["agent", "human", "both"], "description": "A document whose audience is \"human\" is never projected into agent-facing output." },
        "activation": { "$ref": "#/$defs/activation" },
        "enabled": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "ruleFile": {
      "type": "object",
      "description": "Front matter of .stemma/rules/<slug>.md. The Markdown body before any recognised heading is the instruction — the only part an agent sees. Optional \"## Rationale\", \"## Good examples\" and \"## Bad examples\" sections hold human documentation.",
      "additionalProperties": false,
      "required": ["title", "activation"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["must", "should", "may"] },
        "enabled": { "type": "boolean" },
        "activation": { "$ref": "#/$defs/activation" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "procedureFile": {
      "type": "object",
      "description": "Front matter of .stemma/procedures/<slug>.md. The body is the ordered content.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "trigger": { "type": "string" },
        "enabled": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "skillFile": {
      "type": "object",
      "description": "Front matter of .stemma/skills/<slug>.md. The body is the skill content.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "allowedTools": { "type": "array", "items": { "type": "string" } },
        "invocationPolicy": { "type": "string" },
        "enabled": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "agentFile": {
      "type": "object",
      "description": "Front matter of .stemma/agents/<slug>.md. The body is the agent's instructions.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "modelPreference": { "type": "string", "description": "Opaque provider metadata. Stemma never translates model names between providers." },
        "enabled": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "decisionFile": {
      "type": "object",
      "description": "Front matter of .stemma/decisions/<slug>.md. The body carries \"## Context\", \"## Decision\", \"## Consequences\" and \"## Agent constraints\" sections; only the constraints are projected into agent-facing context.",
      "additionalProperties": false,
      "required": ["title", "status"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "accepted", "deprecated", "superseded"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "provenanceFile": {
      "type": "object",
      "description": "The shape of .stemma/provenance.json: machine bookkeeping, never edited by hand. Losing it costs byte-identical round trips, not correctness.",
      "additionalProperties": false,
      "required": ["schemaVersion", "entities", "opaqueBlocks"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "entities": {
          "type": "object",
          "description": "Keyed by entity id.",
          "additionalProperties": { "$ref": "#/$defs/provenance" }
        },
        "opaqueBlocks": { "type": "array", "items": { "$ref": "#/$defs/opaqueBlock" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFormat", "sourcePath", "sourceHash", "importerVersion", "disposition"],
      "properties": {
        "sourceFormat": { "type": "string" },
        "sourcePath": { "type": "string" },
        "sourceHash": { "type": "string", "description": "\"sha256:<hex>\" of the whole source file." },
        "span": { "$ref": "#/$defs/span" },
        "importerVersion": { "type": "string" },
        "disposition": { "enum": ["parsed", "adapted", "preserved-opaque"] },
        "contentHash": { "type": "string", "description": "Digest of the entity as the importer produced it, ignoring provenance. Re-emitting a source file verbatim requires this to still match, so a hand edit is never discarded." },
        "mappings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byteStart": { "type": "integer", "minimum": 0 },
        "byteEnd": { "type": "integer", "minimum": 0 },
        "lineStart": { "type": "integer", "minimum": 0 },
        "lineEnd": { "type": "integer", "minimum": 0 }
      }
    },
    "opaqueBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "sourcePath", "content", "reason", "hash", "reemitForRoundTrip"],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "provider": { "type": "string" },
        "sourcePath": { "type": "string" },
        "content": { "type": "string" },
        "span": { "$ref": "#/$defs/span" },
        "reason": { "type": "string", "minLength": 1 },
        "hash": { "type": "string" },
        "reemitForRoundTrip": { "type": "boolean" }
      }
    }
  }
}
